for target in MMS.sdk_targets:
  sdk = target.sdk
  cxx = target.cxx
  arch = cxx.target.arch
  platform = cxx.target.platform
  sdk_name = sdk['name']

  name = projectName + '.' + sdk['extension']
  binary = MMS.HL2Library(builder, name, sdk, cxx, arch)

  binary.sources += sourceFiles

  compiler = binary.compiler
  if (compiler.version >= 'gcc-4.0') or compiler.family == 'clang':
    compiler.cflags += [ '-Dstrcmpi=strcasecmp', ]

  if compiler.family == 'msvc':
    compiler.cflags += [ '/wd4005' ]

  compiler.cxxincludes += include_paths
  compiler.defines += compiler_defines

  if sdk_name in mods_requiring_runcmd_overrides:
    compiler.defines += [ 'OVERRIDE_RUNCMD' ]

  if '-fno-exceptions' in compiler.cflags:
    compiler.cflags.remove('-fno-exceptions')

  # Additional Linux-specific link dependencies (not covered by manifests)
  if platform in ['linux', 'mac']:
    compiler.linkflags[0:0] = ['-ldl', '-lpthread']

  nodes = builder.Add(binary)
  MMS.binaries += [nodes]
